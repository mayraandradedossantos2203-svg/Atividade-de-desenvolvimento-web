/* Questão 10 - Estilização do Botão */

.btn {
    /* 1. Cor de fundo e do texto */
    background-color: #2ecc71; 
    color: yellow;
    
    /* 2. Espaçamento interno (padding) */
    padding: 12px 25px;
    
    /* 3. Bordas arredondadas */
    border: none;
    border-radius: 25px;
    
    /* 4. Cursor pointer (mãozinha) */
    cursor: pointer;
    
    /* Propriedades extras para ficar bonito */
    font-size: 16px;
    font-family: sans-serif;
    transition: 0.3s; /* Deixa a mudança de cor suave */
}

/* 5. Efeito hover com alteração de cor */
.btn:hover {
    background-color: #3498db;; /* Verde um pouco mais escuro */
}
